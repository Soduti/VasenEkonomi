@page
@model Vasen.Web.Pages.Account.ChoosePasswordModel
@{ ViewData["Title"] = "Välj lösenord"; }
<div class="members-page">
<h1>Välj ditt lösenord</h1>
<p class="hint">Byt det tillfälliga lösenordet för att komma vidare.</p>
<form method="post" class="panel narrow stack member-form">
    <div asp-validation-summary="All" class="validation" role="alert"></div>
    <label>Nytt lösenord<input asp-for="NewPassword" type="password" autocomplete="new-password" minlength="10" required /></label>
    <label>Upprepa lösenordet<input asp-for="ConfirmPassword" type="password" autocomplete="new-password" minlength="10" required /></label>
    <p class="hint">Minst 10 tecken med stor och liten bokstav samt en siffra.</p>
    <button class="button primary">Spara och fortsätt</button>
</form>
<form method="post" asp-page-handler="Logout"><button class="text-button">Logga ut</button></form>
</div>
