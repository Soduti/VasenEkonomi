@page
@model Vasen.Web.Pages.Expenses.IndexModel
@{ ViewData["Title"] = "Gemensamma utgifter"; }
<div class="budget-page">
<div class="budget-heading"><h1>Utgifter</h1><form method="get" class="year-picker"><label>År<input asp-for="Year" type="number" min="2000" max="2100" /></label><button class="button secondary">Visa</button></form></div>
<p class="hint">Betalt direkt från gemensamt konto, exempelvis autogiro och lån. Redan reglerat utan personuttag.</p>
@if (Access.IsOwner) { <div class="budget-actions"><a class="button primary" asp-page="Edit" asp-route-year="@Model.Year">＋ Registrera utgift</a></div> }
@if(Model.Expenses.Count == 0) { <p class="hint">Inga gemensamma utgifter registrerade för @Model.Year.</p> }
else
{
<div class="budget-table-wrap"><table class="budget-table expense-table" aria-label="Gemensamma utgifter @Model.Year">
<thead><tr><th scope="col">Kostnad</th><th scope="col" class="money-cell">Betalt från kontot</th></tr></thead>
<tbody>
@foreach(var expense in Model.Expenses)
{
    <tr><th scope="row"><a class="budget-row-link" href="@(Access.IsOwner ? Url.Page("Edit",new { id = expense.Id }) : null)">@expense.Category@if (!string.IsNullOrEmpty(expense.Comment)) { <span class="budget-row-note">@expense.Comment</span> }</a></th><td class="money-cell">@Money.Format(expense.AmountOre)</td></tr>
}
</tbody><tfoot><tr><th scope="row">Summa @Model.Year</th><td class="money-cell">@Money.Format(Model.Expenses.Sum(x => x.AmountOre))</td></tr></tfoot></table></div>
}
@if (Access.IsOwner) { <p class="hint">Registrera delbelopp eller årssummor. Tryck på kostnadsslaget för att rätta en post.</p> }
<a class="back-link" asp-page="/Budget/Index" asp-route-year="@Model.Year">Visa budgeten →</a>
</div>
