@page "{id:int?}"
@model Vasen.Web.Pages.Expenses.EditModel
@{ ViewData["Title"] = "Gemensam utgift"; }
<a class="back-link" asp-page="Index" asp-route-year="@Model.Year">← Alla gemensamma utgifter</a><p class="eyebrow">FRÅN GEMENSAMT KONTO</p><h1>@(Model.Id.HasValue ? "Ändra utgift" : "Registrera en utgift")</h1><p class="muted">Ingen kvittobilaga behövs. Flera belopp för samma kostnadsslag summeras på året.</p>
<form method="post" class="panel stack narrow"><div asp-validation-summary="All" class="validation" role="alert"></div><input type="hidden" asp-for="Id" /><input type="hidden" asp-for="Version" />
<label>År<input asp-for="Year" type="number" min="2000" max="2100" required /></label><label>Kostnadsslag<input asp-for="Category" maxlength="80" list="expense-categories" required /><datalist id="expense-categories"><option>El</option><option>Lån</option><option>Försäkring</option><option>Vatten</option><option>Avfall</option></datalist></label><label>Betalt belopp (kr)<input asp-for="Amount" inputmode="decimal" required /></label><label>Kommentar (valfritt)<input asp-for="Comment" maxlength="300" placeholder="Till exempel el januari–juni" /></label><button class="button primary">Spara utgift</button><a class="button secondary" asp-page="Index" asp-route-year="@Model.Year">Avbryt</a></form>
@if(Model.Id.HasValue) { <form method="post" asp-page-handler="Void" class="narrow section-gap" data-confirm="Makulera utgiften? Den tas bort ur summorna och historiken behålls."><input type="hidden" asp-for="Id" /><input type="hidden" asp-for="Version" /><input type="hidden" asp-for="Year" /><button class="button danger">Makulera utgift</button></form> }
