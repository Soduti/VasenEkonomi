<Project>
  <PropertyGroup>
    <WebPublishMethod>FileSystem</WebPublishMethod>
    <PublishProvider>FileSystem</PublishProvider>
    <_TargetId>Folder</_TargetId>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <LaunchSiteAfterPublish>false</LaunchSiteAfterPublish>
    <EnvironmentName>Production</EnvironmentName>
    <!-- Separat byggmapp per publicering för att inte återanvända gamla filer. -->
    <VasenPublishId>$([System.Guid]::NewGuid().ToString('N'))</VasenPublishId>
    <PublishDir>$(MSBuildProjectDirectory)\..\..\artifacts\server-publish\$(VasenPublishId)\</PublishDir>
    <PublishUrl>$(PublishDir)</PublishUrl>
    <DeleteExistingFiles>false</DeleteExistingFiles>
    <DeployToNetworkShare Condition="'$(DeployToNetworkShare)' == ''">true</DeployToNetworkShare>
    <NetworkDeployRoot Condition="'$(NetworkDeployRoot)' == ''">Y:\</NetworkDeployRoot>
  </PropertyGroup>

  <!-- AfterPublish används av VS/DeployOnBuild, Publish av dotnet publish.
       MSBuild kör denna target högst en gång per publicering. -->
  <Target Name="VasenDeployToNetworkShare" AfterTargets="AfterPublish;Publish"
          Condition="'$(DeployToNetworkShare)' == 'true'">
    <PropertyGroup>
      <!-- Punkten gör även en enhetsrot säker framför avslutande citattecken. -->
      <VasenNetworkDeployRoot>$([System.IO.Path]::Combine('$(NetworkDeployRoot)', '.'))</VasenNetworkDeployRoot>
      <VasenDeployScript>$(MSBuildProjectDirectory)\..\..\Publish-ToNetworkShare.ps1</VasenDeployScript>
      <VasenLocalPublishDir>$([System.IO.Path]::GetFullPath('$(PublishDir)'))</VasenLocalPublishDir>
      <!-- Undvik avslutande backslash framför citattecken i Windows-anropet. -->
      <VasenLocalPublishDir>$([System.String]::Copy('$(VasenLocalPublishDir)').TrimEnd('\'))</VasenLocalPublishDir>
    </PropertyGroup>
    <Message Importance="high" Text="Publicerar Vasen till $(NetworkDeployRoot) (Release och Current)." />
    <Exec Command="&quot;$(SystemRoot)\System32\WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(VasenDeployScript)&quot; -SkipPublish -LocalPublishDir &quot;$(VasenLocalPublishDir)&quot; -ShareRoot &quot;$(VasenNetworkDeployRoot)&quot;" />
  </Target>
</Project>
